# ==============================================================================
# KrishiConnect — Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local:
#    cp .env.example .env.local
# 2. Replace the placeholders with your actual project credentials.
# 3. DO NOT commit .env.local or any real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Required for Auth, PostgreSQL & Storage)
# Obtain these from: Supabase Dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your Supabase Service Role Key (SERVER-ONLY. NEVER prefix with NEXT_PUBLIC_ or expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Weather Service Configuration (Milestone 7)
# Open-Meteo free agro-meteorological API endpoint
# ------------------------------------------------------------------------------
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ------------------------------------------------------------------------------
# 3. Agricultural AI Assistant (Milestone 7)
# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# SERVER-ONLY.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 4. Mock Data Override
# Set to 'true' to force mock repositories even if Supabase credentials exist.
# Set to 'false' or omit to use live Supabase database when configured.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK_DATA=true

# ------------------------------------------------------------------------------
# 5. Application Base URL & Environment
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
